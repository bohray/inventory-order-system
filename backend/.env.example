# --- Backend environment variables ---
# Copy to .env and fill in real values. Do NOT commit the real .env.

# Full SQLAlchemy database URL.
# Local docker-compose uses the "db" service hostname:
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/inventory

# Comma-separated list of allowed CORS origins (the frontend URLs).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Products at or below this stock level are flagged as "low stock".
LOW_STOCK_THRESHOLD=10
