# --- Backend environment variables ---
# Copy to .env and fill in real values. Do NOT commit the real .env.

# Full SQLAlchemy database URL.
# Local docker-compose uses the "db" service hostname:
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/inventory

# Hosted DB (e.g. Supabase): use the SESSION POOLER string (IPv4; the direct
# connection is IPv6-only and fails on Render), and keep ?sslmode=require. Shape:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Comma-separated list of allowed CORS origins (the frontend URLs).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Products at or below this stock level are flagged as "low stock".
LOW_STOCK_THRESHOLD=10
