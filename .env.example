# --- Root environment for docker-compose ---
# Copy to .env (which is gitignored) and adjust. docker-compose reads this file
# automatically. Credentials live here, never in committed code.

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=inventory

# Allowed CORS origins for the backend (the frontend's URL).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Low-stock threshold used by the dashboard.
LOW_STOCK_THRESHOLD=10

# Backend URL the frontend is built against (baked into the static bundle).
VITE_API_BASE_URL=http://localhost:8000
